#!/usr/bin/env node
/*
 * VHSCode — opencode preset for GitHub Copilot + local Ollama, routed through headroom.
 *
 * Run with `vhscode` exactly like `opencode`. Behind the scenes this:
 *   1. Prepares a config that pins Copilot for hard work + a small local model for utility tasks.
 *   2. Launches the headroom proxy as a sidecar so all tool outputs / prompts get compressed.
 *   3. Routes Copilot through headroom by overriding the provider baseURL.
 *   4. Spawns opencode with OPENCODE_CONFIG pointing at the rendered preset.
 *
 * Env knobs:
 *   VHSCODE_HEADROOM=off            disable the headroom sidecar
 *   VHSCODE_HEADROOM_PORT=8787      override proxy port
 *   VHSCODE_LOCAL_BASE_URL=...      override local LLM endpoint (default http://127.0.0.1:11434/v1)
 *   VHSCODE_COPILOT_BASE_URL=...    override Copilot endpoint (default: headroom proxy if up, else direct)
 *   VHSCODE_CONFIG=path/to.json     use a custom config instead of the bundled preset
 */

const fs = require("fs")
const os = require("os")
const path = require("path")
const net = require("net")
const childProcess = require("child_process")

const SELF_DIR = path.dirname(fs.realpathSync(__filename))
const PKG_ROOT = path.resolve(SELF_DIR, "..")
const BUNDLED_CONFIG = path.join(PKG_ROOT, "config", "vhscode.json")
const BUNDLED_OPENCODE_DIR = path.join(PKG_ROOT, "opencode-dir")
const VHSCODE_HOME = process.env.VHSCODE_HOME || path.join(os.homedir(), ".vhscode")
const RUNTIME_DIR = path.join(VHSCODE_HOME, "runtime")
const LOG_DIR = path.join(VHSCODE_HOME, "logs")
const RENDERED_OPENCODE_DIR = path.join(VHSCODE_HOME, "opencode-dir")

const SIGNALS = ["SIGINT", "SIGTERM", "SIGHUP"]

function log(msg) {
  if (process.env.VHSCODE_QUIET === "1") return
  process.stderr.write(`[vhscode] ${msg}\n`)
}

function ensureDirs() {
  fs.mkdirSync(RUNTIME_DIR, { recursive: true })
  fs.mkdirSync(LOG_DIR, { recursive: true })
}

function which(cmd) {
  const pathExt = process.platform === "win32" ? [".exe", ".cmd", ".bat", ""] : [""]
  for (const dir of (process.env.PATH || "").split(path.delimiter)) {
    for (const ext of pathExt) {
      const candidate = path.join(dir, cmd + ext)
      try {
        fs.accessSync(candidate, fs.constants.X_OK)
        return candidate
      } catch {}
    }
  }
  return null
}

function probePort(port, host = "127.0.0.1") {
  return new Promise((resolve) => {
    const s = net.createConnection({ port, host })
    s.setTimeout(250)
    s.on("connect", () => {
      s.destroy()
      resolve(true)
    })
    s.on("timeout", () => {
      s.destroy()
      resolve(false)
    })
    s.on("error", () => resolve(false))
  })
}

async function waitForPort(port, timeoutMs) {
  const deadline = Date.now() + timeoutMs
  while (Date.now() < deadline) {
    if (await probePort(port)) return true
    await new Promise((r) => setTimeout(r, 150))
  }
  return false
}

function renderConfig(src, dst, vars) {
  const raw = fs.readFileSync(src, "utf8")
  const rendered = raw.replace(/\$\{([A-Z0-9_]+):-([^}]*)\}/g, (_, name, fallback) => {
    return process.env[name] || vars[name] || fallback
  })
  fs.writeFileSync(dst, rendered)
}

function copyDirRecursive(src, dst) {
  fs.mkdirSync(dst, { recursive: true })
  for (const entry of fs.readdirSync(src, { withFileTypes: true })) {
    const s = path.join(src, entry.name)
    const d = path.join(dst, entry.name)
    if (entry.isDirectory()) copyDirRecursive(s, d)
    else fs.copyFileSync(s, d)
  }
}

// Materialize the bundled opencode-dir into VHSCODE_HOME, with the .jsonc
// template rendered. We re-render on every launch so env-driven URLs (like the
// headroom proxy port) stay current, but we preserve user edits under
// `agent.user/` and `plugin.user/` if they exist.
function materializeOpencodeDir(vars) {
  if (!fs.existsSync(BUNDLED_OPENCODE_DIR)) return null
  fs.mkdirSync(RENDERED_OPENCODE_DIR, { recursive: true })
  copyDirRecursive(BUNDLED_OPENCODE_DIR, RENDERED_OPENCODE_DIR)
  const templatedConfig = path.join(RENDERED_OPENCODE_DIR, "opencode.jsonc")
  if (fs.existsSync(templatedConfig)) {
    renderConfig(templatedConfig, templatedConfig, vars)
  }
  return RENDERED_OPENCODE_DIR
}

async function startHeadroom(port) {
  if (process.env.VHSCODE_HEADROOM === "off") return null

  if (await probePort(port)) {
    log(`headroom proxy already listening on :${port}`)
    return { port, sidecar: null }
  }

  const headroomBin = which("headroom")
  if (!headroomBin) {
    log("headroom binary not found — install with `pipx install headroom-ai` or skip via VHSCODE_HEADROOM=off")
    log("continuing without compression (token savings disabled)")
    return null
  }

  const logPath = path.join(LOG_DIR, "headroom.log")
  const out = fs.openSync(logPath, "a")
  const sidecar = childProcess.spawn(headroomBin, ["proxy", "--port", String(port)], {
    stdio: ["ignore", out, out],
    detached: false,
    env: { ...process.env, HEADROOM_QUIET: "1" },
  })
  sidecar.unref()

  const ready = await waitForPort(port, 5000)
  if (!ready) {
    log(`headroom failed to start within 5s (see ${logPath}) — continuing without compression`)
    try { sidecar.kill() } catch {}
    return null
  }
  log(`headroom proxy ready on :${port} (logs: ${logPath})`)
  return { port, sidecar }
}

function resolveOpencodeBin() {
  // Prefer locally installed opencode (npm/bun); fall back to PATH.
  const candidates = [
    path.resolve(PKG_ROOT, "..", "packages", "opencode", "bin", "opencode"),
    path.resolve(PKG_ROOT, "node_modules", ".bin", "opencode"),
    which("opencode"),
  ].filter(Boolean)
  for (const c of candidates) {
    if (fs.existsSync(c)) return c
  }
  return null
}

function spawnOpencode(bin, args, env) {
  const child = childProcess.spawn(bin, args, { stdio: "inherit", env })
  const fwd = {}
  for (const sig of SIGNALS) {
    fwd[sig] = () => { try { child.kill(sig) } catch {} }
    process.on(sig, fwd[sig])
  }
  return new Promise((resolve) => {
    child.on("exit", (code, signal) => {
      for (const sig of SIGNALS) process.removeListener(sig, fwd[sig])
      if (signal) {
        process.kill(process.pid, signal)
        return
      }
      resolve(typeof code === "number" ? code : 0)
    })
    child.on("error", (err) => {
      process.stderr.write(`[vhscode] failed to launch opencode: ${err.message}\n`)
      resolve(1)
    })
  })
}

function runScript(rel, args) {
  const script = path.join(PKG_ROOT, "scripts", rel)
  const cmd = rel.endsWith(".sh") ? "bash" : process.execPath
  const child = childProcess.spawnSync(cmd, [script, ...args], { stdio: "inherit" })
  process.exit(child.status || 0)
}

function handleBuiltins(argv) {
  const cmd = argv[0]
  if (!cmd) return false
  if (cmd === "setup") { runScript("setup.sh", argv.slice(1)); return true }
  if (cmd === "doctor") { runScript("doctor.js", argv.slice(1)); return true }
  if (cmd === "headroom") {
    const headroomBin = which("headroom")
    if (!headroomBin) {
      process.stderr.write("[vhscode] headroom not installed. Run `vhscode setup` first.\n")
      process.exit(1)
    }
    const child = childProcess.spawnSync(headroomBin, argv.slice(1), { stdio: "inherit" })
    process.exit(child.status || 0)
  }
  if (cmd === "--vhscode-version" || cmd === "vhscode-version") {
    const pkg = JSON.parse(fs.readFileSync(path.join(PKG_ROOT, "package.json"), "utf8"))
    process.stdout.write(`vhscode ${pkg.version}\n`)
    process.exit(0)
  }
  return false
}

async function main() {
  ensureDirs()

  if (handleBuiltins(process.argv.slice(2))) return

  const headroomPort = Number(process.env.VHSCODE_HEADROOM_PORT || 8787)
  const headroom = await startHeadroom(headroomPort)

  const copilotDefault = headroom
    ? `http://127.0.0.1:${headroom.port}/v1/upstream/api.githubcopilot.com`
    : "https://api.githubcopilot.com"

  const renderVars = {
    VHSCODE_COPILOT_BASE_URL: copilotDefault,
    VHSCODE_LOCAL_BASE_URL: process.env.VHSCODE_LOCAL_BASE_URL || "http://127.0.0.1:11434/v1",
  }

  // The opencode-dir contains the orchestrator agent, the verifier, the
  // tier-routed workers, and the orchestrator plugin. OPENCODE_CONFIG_DIR is
  // the supported way to inject all of these at once.
  const configDir = materializeOpencodeDir(renderVars)

  // For users supplying a plain config-only override via VHSCODE_CONFIG, still
  // render it to a flat path that OPENCODE_CONFIG can point at.
  let renderedConfig = null
  if (process.env.VHSCODE_CONFIG) {
    renderedConfig = path.join(RUNTIME_DIR, "vhscode.rendered.json")
    renderConfig(process.env.VHSCODE_CONFIG, renderedConfig, renderVars)
  }

  const opencode = resolveOpencodeBin()
  if (!opencode) {
    process.stderr.write(
      "[vhscode] could not locate the opencode binary. Install it with `npm i -g opencode-ai` or run inside the opencode workspace.\n",
    )
    process.exit(1)
  }

  const env = {
    ...process.env,
    VHSCODE_ACTIVE: "1",
  }
  if (configDir) env.OPENCODE_CONFIG_DIR = configDir
  if (renderedConfig) env.OPENCODE_CONFIG = renderedConfig

  const code = await spawnOpencode(opencode, process.argv.slice(2), env)

  if (headroom?.sidecar) {
    try { headroom.sidecar.kill() } catch {}
  }
  process.exit(code)
}

main().catch((err) => {
  process.stderr.write(`[vhscode] fatal: ${err.stack || err.message}\n`)
  process.exit(1)
})
